/* Modal Overlays */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    z-index: 1050;
}

.modal-overlay.active {
    display: flex;
}

.modal-box-custom {
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    width: 90%;
    max-width: 500px;
    animation: fadeIn 0.3s ease-out;
    overflow: hidden;
}

.modal-header-custom {
    background-color: #007bff;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header-custom .modal-title {
    margin-bottom: 0;
    font-size: 1.25rem;
}

.modal-header-custom .btn-close-white {
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
}

.modal-body-custom {
    padding: 20px;
}

.resume-box {
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.resume-item {
    display: flex;
    align-items: center;
    gap: 10px;
}

.resume-item i {
    color: #007bff;
    font-size: 1.2rem;
}

.resume-item strong {
    display: block;
    font-size: 0.9rem;
    color: #555;
}

.resume-item span {
    font-size: 0.8rem;
    color: #6c757d;
}

.form-group {
    margin-bottom: 15px;
}

.form-label {
    font-weight: bold;
    display: block;
    margin-bottom: 5px;
}

.form-control {
    width: 100%;
    padding: 10px;
    border: 1px solid #ced4da;
    border-radius: 5px;
}

.input-group {
    display: flex;
    align-items: center;
}

.input-group .form-control {
    flex-grow: 1;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.input-group .input-group-text {
    background-color: #e9ecef;
    border: 1px solid #ced4da;
    border-left: none;
    padding: 10px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    color: #495057;
}

.input-group .input-group-text.check {
    background-color: #28a745;
    color: white;
    border-color: #28a745;
}

.form-control.valid-border {
    border-color: #28a745;
}

.row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
}

.note-text {
    font-size: 0.8rem;
    color: #6c757d;
    margin-top: 15px;
}

.modal-actions {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 20px;
}

.btn-cancel {
    background-color: #6c757d;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
    flex-grow: 1;
    transition: background-color 0.2s ease;
}

.btn-cancel:hover {
    background-color: #5a6268;
}

.btn-confirm {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
    flex-grow: 1;
    transition: background-color 0.2s ease;
}

.btn-confirm:hover {
    background-color: #0056b3;
}

